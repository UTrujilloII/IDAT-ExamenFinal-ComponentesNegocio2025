            },
            "description": "Buscar libros por autor"
          }
        },
        {
          "name": "Buscar por Categoría",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/libros/buscar/categoria?categoria=Programación",
              "host": ["{{base_url}}"],
              "path": ["libros", "buscar", "categoria"],
              "query": [
                {
                  "key": "categoria",
                  "value": "Programación"
                }
              ]
            },
            "description": "Buscar libros por categoría"
          }
        },
        {
          "name": "Obtener Categorías",
          "request": {
            "method": "GET",
            "header": [],
